# ============================================================
#  ITHub  ·  ithub.intellihelp.tech
#
#  Sirve tal cual los archivos reales (assets) y pasa todo lo demás a
#  index.php con la ruta en ?r= (el ruteo de verdad lo hace index.php).
#  Niega por HTTP los archivos sensibles y fija el caché de los assets.
#  La carpeta app/ (código, vistas) tiene su propio .htaccess que niega todo.
# ============================================================

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Siempre HTTPS (las cookies de sesión son Secure y OpenID Connect lo exige).
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # El encabezado Authorization (Basic de /oauth/token, Bearer de
    # /oauth/userinfo) no llega a PHP en algunos Apache si no se pasa a mano.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Servir archivos reales tal cual (assets).
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Todo lo demás -> front controller (incluye /.well-known/openid-configuration).
    RewriteRule ^([A-Za-z0-9./_-]*)$ index.php?r=$1 [L,QSA]
</IfModule>

# Archivos que nunca se sirven, aunque alguien los deje en el webroot.
<FilesMatch "\.(sql|md|json|lock|log|ini|yml|yaml|py|sh|bak|old|orig|swp|dist|env|txt|gz|zip|tar|pem|key|sqlite)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<Files "config.local.php">
    Require all denied
</Files>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Caché larga para assets: CSS y JS van versionados con ?v=.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|png|jpe?g|gif|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
